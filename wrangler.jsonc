{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podology-mk-platform",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "podology-mk-content", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations"}],
  "observability": {"enabled": true}
}
